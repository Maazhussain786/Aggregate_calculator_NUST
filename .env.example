# NUST Aggregate Calculator - Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================
# CONTACT FORM (Optional)
# ============================================
# Web3Forms API Key for contact form
# Get your free access key from https://web3forms.com/
# 1. Go to https://web3forms.com/
# 2. Enter your email (maazhussain972@gmail.com)
# 3. You'll receive an access key in your email
# 4. Paste it below
WEB3FORMS_ACCESS_KEY=your_access_key_here

# ============================================
# DATABASE (Optional - app works without it)
# ============================================
# The app automatically uses JSON data if DATABASE_URL is not set
# You don't need a database for development!

# Option 1: No Database (Recommended)
# Just leave DATABASE_URL commented out or unset
# App will use src/data/sampleMeritData.json

# Option 2: SQLite (Local Development)
# Simple file-based database - great for testing
# DATABASE_URL="file:./dev.db"

# Option 3: PostgreSQL (Production)
# For Supabase, Neon, Railway, or Vercel Postgres
# ⚠️ IMPORTANT: Add ?sslmode=require for SSL connections!
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Common PostgreSQL SSL connection formats:
# Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Neon:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require"

# Vercel Postgres:
# POSTGRES_URL="postgres://[user]:[pass]@[host]/[db]?sslmode=require"
# DATABASE_URL="${POSTGRES_URL}"

# Railway:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway?sslmode=require"

# Azure PostgreSQL:
# DATABASE_URL="postgresql://username@servername:password@servername.postgres.database.azure.com:5432/dbname?sslmode=require"
# Note: Azure usernames include @servername suffix. You may need to URL encode it as %40
# DATABASE_URL="postgresql://username%40servername:password@servername.postgres.database.azure.com:5432/dbname?ssl=true"

# ⚠️ SSL ERROR FIX:
# If you get "SSL connection required" error, add ?sslmode=require to the end of your URL
# See COLLABORATOR_SETUP.md for detailed troubleshooting
