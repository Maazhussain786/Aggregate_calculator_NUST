# NUST Aggregate Calculator - Environment Variables
# Copy this file to .env.local and fill in the values

# Web3Forms API Key (Required for contact form to work)
# Get your free access key from https://web3forms.com/
# 1. Go to https://web3forms.com/
# 2. Enter your email (maazhussain972@gmail.com)
# 3. You'll receive an access key in your email
# 4. Paste it below
WEB3FORMS_ACCESS_KEY=your_access_key_here

# Database URL (Optional - app works without it using sample data)
# DATABASE_URL=file:./dev.db
